[Unit]
Description=TheFoldBot Discord bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/TheFoldBot
EnvironmentFile=/root/TheFoldBot/.env
ExecStart=/usr/bin/env sh -lc 'vp run start'
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
