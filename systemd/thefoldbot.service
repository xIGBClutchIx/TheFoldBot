[Unit]
Description=TheFoldBot Discord bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/TheFoldBot
EnvironmentFile=/root/TheFoldBot/.env
ExecStart=/root/TheFoldBot/scripts/vp.sh run start
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
